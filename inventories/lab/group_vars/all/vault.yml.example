---
# Copy to vault.yml and encrypt:  ansible-vault encrypt inventories/lab/group_vars/all/vault.yml
vault_proxmox_api_password: "change-me"
vault_pbs_password: "change-me"
vault_pbs_fingerprint: "AA:BB:..."
vault_slurmdbd_db_password: "change-me"
vault_grafana_admin_password: "change-me"
vault_munge_key_b64: "<output of: dd if=/dev/urandom bs=1 count=1024 | base64 -w0>"
vault_rgw_s3_access_key: "change-me"
vault_rgw_s3_secret_key: "change-me"
vault_wireguard_hub_private_key: "<wg genkey>"
