# {{ ansible_managed }}
global:
  scrape_interval: 30s
  evaluation_interval: 30s
  external_labels:
    cluster: {{ cluster_name }}

rule_files: [/etc/prometheus/alert-rules.yml]

alerting:
  alertmanagers:
    - static_configs: [{ targets: ["127.0.0.1:9093"] }]

scrape_configs:
  - job_name: node
    static_configs:
{% for group in ['slurm_controller', 'slurm_login', 'monitoring', 'compute', 'ceph'] %}
      - labels: { role: {{ group }} }
        targets:
{% for h in groups[group] %}
          - "{{ hostvars[h].ansible_host }}:9100"
{% endfor %}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        regex: "([^:]+):.*"
        target_label: instance
        replacement: "$1"

  - job_name: slurm
    scrape_interval: 60s
    scrape_timeout: 50s
    static_configs:
      - targets: ["{{ hostvars[slurm_controller_host].ansible_host }}:9341"]

  - job_name: ceph
    honor_labels: true
    static_configs:
      - targets:
{% for h in groups['ceph'] %}
          - "{{ hostvars[h].ansible_host }}:9283"
{% endfor %}
