---
extends: default
ignore: |
  collections/
  .venv/
  venv/
rules:
  line-length:
    max: 160
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  # allow column-aligned inventories / data tables
  commas:
    max-spaces-after: -1
  colons:
    max-spaces-after: -1
  document-start:
    ignore: |
      .github/
